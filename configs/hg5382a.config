# FiberHome HG5382A（Airoha AN7581）个人编译增量配置
# 用法：./scripts/kconfig.pl + configs/an7581.config + configs/release.config configs/hg5382a.config > .config
# 注意：设备过滤由 .github/workflows/build-hg5382a.yml 完成，本文件只负责软件包选择。

# 多拨：同步拨号（Virtual WAN / macvlan）+ mwan3 负载均衡
CONFIG_PACKAGE_luci-app-syncdial=y
CONFIG_PACKAGE_luci-app-mwan3=y
CONFIG_PACKAGE_mwan3=y
CONFIG_PACKAGE_kmod-macvlan=y

# luci-app-syncdial 为 Lua 应用，新版 LuCI 需要兼容层才能运行
CONFIG_PACKAGE_luci-compat=y
